# Local settings. Keep real secrets in an untracked .env file.
APP_ENV=development
DATABASE_URL=sqlite:///data/vericarb.sqlite3
VERICARB_DATA_DIR=./data
VERICARB_TOKEN_SECRET=replace-with-a-long-random-local-secret
TOKEN_TTL_SECONDS=28800
AUTO_MIGRATE=true
SEED_DEMO_DATA=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
LOG_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTED_CHARS=500000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AI_DAILY_TOKEN_LIMIT=100000

# Leave bucket empty for local disk storage. Production deployments require an
# S3-compatible bucket. Credentials are obtained from the AWS SDK credential
# chain (for example, the platform's service identity), never from this file.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_PREFIX=evidence

# Public Maculatus settings are verified against the X1 RPC/explorer. Never put
# private keys in this tracked example file.
# Nebius Token Factory (OpenAI-compatible chat completions). Keep keys only
# in an ignored local .env or a managed secret store; never commit a real key.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CONNECT_TIMEOUT_SECONDS=5
NEBIUS_READ_TIMEOUT_SECONDS=60
NEBIUS_MAX_RETRIES=2
AI_MAX_COMPLETION_TOKENS=1800
# Optional provider rates; omit them until you confirm current account pricing.
AI_INPUT_COST_PER_MILLION_USD=
AI_OUTPUT_COST_PER_MILLION_USD=
X1_TESTNET_RPC_URL=https://maculatus-rpc.x1eco.com
X1_TESTNET_CHAIN_ID=10778
X1_TESTNET_EXPLORER_URL=https://maculatus-scan.x1eco.com
X1_TESTNET_NATIVE_CURRENCY=X1T
X1_REGISTRY_CONTRACT_ADDRESS=
# Optional separate, append-only report commitment contract. The existing registry is unchanged.
X1_REPORT_ANCHOR_CONTRACT_ADDRESS=
X1_DEPLOYER_PRIVATE_KEY=
X1_REGISTRAR_PRIVATE_KEY=
X1_REVIEWER_PRIVATE_KEY=
